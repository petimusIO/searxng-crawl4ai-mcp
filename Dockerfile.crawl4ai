# Crawl4AI Service Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    unzip \
    curl \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

# Install Chrome
RUN wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/googlechrome-linux-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/googlechrome-linux-keyring.gpg] http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

# Install Crawl4AI and dependencies
RUN pip install --no-cache-dir \
    crawl4ai \
    fastapi \
    uvicorn \
    pydantic \
    httpx \
    asyncio \
    aiofiles

# Install Playwright browsers
RUN playwright install chromium
RUN playwright install-deps

# Create the FastAPI service
COPY <<EOF /app/crawl4ai_service.py
import asyncio
import os
from typing import List, Optional, Dict, Any
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import httpx
from crawl4ai import (
    AsyncWebCrawler,
    CrawlerRunConfig,
    PruningContentFilter,
    BM25ContentFilter,
    DefaultMarkdownGenerator,
)
from crawl4ai.async_crawler_strategy import AsyncHTTPCrawlerStrategy
import time
import logging

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

app = FastAPI(title="Crawl4AI Service", version="2.0.0")

# Default excluded tags — strips nav, header, footer, ads, forms, scripts, etc.
DEFAULT_EXCLUDED_TAGS = [
    'nav', 'header', 'footer', 'aside', 'form', 'button',
    'script', 'style', 'iframe', 'noscript', 'svg',
    'ad', 'ads', 'sidebar', 'menu', 'popup', 'modal',
]

# ---------------------------------------------------------------------------
# Session rotation — prevents memory leaks in long-running browser sessions
# Rotates session_id every 100 requests or 10 minutes idle.
# ---------------------------------------------------------------------------
_request_counter = 0
_last_rotation = time.time()

def get_session_id() -> str:
    global _request_counter, _last_rotation
    _request_counter += 1
    if _request_counter >= 100 or (time.time() - _last_rotation) > 600:
        _request_counter = 0
        _last_rotation = time.time()
    return f"scraper_{int(_last_rotation)}"

class ScrapeRequest(BaseModel):
    url: str
    formats: Optional[List[str]] = ["markdown"]
    wait_for: Optional[int] = 0
    timeout: Optional[int] = 30000
    proxy_url: Optional[str] = None
    # Content filtering options
    content_filter: Optional[str] = None  # "pruning" | "bm25" | "chain" | "none"
    filter_query: Optional[str] = None    # query for BM25, PruningContentFilter, or chain
    # Fetch mode
    http_mode: Optional[str] = "auto"     # "auto" | "http" | "browser"

class BatchScrapeRequest(BaseModel):
    urls: List[str]
    formats: Optional[List[str]] = ["markdown"]
    concurrency: Optional[int] = 3
    # Content filtering options
    content_filter: Optional[str] = None
    filter_query: Optional[str] = None
    # Fetch mode
    http_mode: Optional[str] = "auto"

class ExtractRequest(BaseModel):
    url: str
    prompt: str
    schema: Optional[Dict[str, Any]] = None

# Global crawler instance
crawler = None

@app.on_event("startup")
async def startup_event():
    global crawler
    proxy_url = os.getenv("PROXY_URL")

    # Configure browser args with proxy if provided
    browser_args = [
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-dev-shm-usage",
        "--disable-background-timer-throttling",
        "--disable-backgrounding-occluded-windows",
        "--disable-renderer-backgrounding"
    ]

    if proxy_url:
        browser_args.append(f"--proxy-server={proxy_url}")
        logger.info(f"Using proxy: {proxy_url.split('@')[1] if '@' in proxy_url else proxy_url}")

    crawler = AsyncWebCrawler(
        browser_type="chromium",
        headless=True,
        browser_args=browser_args
    )
    logger.info("Crawl4AI service started")

@app.on_event("shutdown")
async def shutdown_event():
    global crawler
    if crawler:
        logger.info("Crawl4AI service stopped")

@app.get("/health")
async def health_check():
    return {"status": "ok", "service": "crawl4ai"}


class ChainedContentFilter:
    """
    Two-stage content filter:
      Stage 1: PruningContentFilter — removes structural noise (ads, nav, footers)
      Stage 2: BM25ContentFilter — extracts query-relevant chunks from cleaned text
    Produces the smallest, cleanest, most relevant output.
    """
    def __init__(
        self,
        user_query: str,
        pruning_threshold: float = 0.48,
        pruning_threshold_type: str = "dynamic",
        pruning_min_word_threshold: int = 50,
        bm25_threshold: float = 1.0,
        language: str = "english",
    ):
        self.pruning_filter = PruningContentFilter(
            threshold=pruning_threshold,
            threshold_type=pruning_threshold_type,
            min_word_threshold=pruning_min_word_threshold,
        )
        self.bm25_filter = BM25ContentFilter(
            user_query=user_query,
            bm25_threshold=bm25_threshold,
            language=language,
        )

    def filter_content(self, html: str, min_word_threshold: int = None) -> List[str]:
        # Stage 1: Remove structural noise — returns List[str]
        pruned_chunks = self.pruning_filter.filter_content(html, min_word_threshold)
        # Join pruned chunks back into a single HTML string for BM25 input
        pruned_html = "\n\n".join(pruned_chunks) if isinstance(pruned_chunks, list) else pruned_chunks
        # Stage 2: Extract query-relevant chunks — returns List[str]
        relevant = self.bm25_filter.filter_content(pruned_html, min_word_threshold)
        return relevant


def _build_content_filter(content_filter: Optional[str], filter_query: Optional[str]):
    """Build a content filter based on the requested type."""
    if not content_filter or content_filter == "none":
        return None

    if content_filter == "pruning":
        kwargs = {
            "threshold": 0.48,
            "threshold_type": "dynamic",
            "min_word_threshold": 50,
        }
        if filter_query:
            kwargs["user_query"] = filter_query
        return PruningContentFilter(**kwargs)

    if content_filter == "bm25":
        kwargs = {"bm25_threshold": 1.0}
        if filter_query:
            kwargs["user_query"] = filter_query
        return BM25ContentFilter(**kwargs)

    if content_filter == "chain":
        if not filter_query:
            logger.warning("chain filter requires filter_query, falling back to pruning")
            return PruningContentFilter(
                threshold=0.48,
                threshold_type="dynamic",
                min_word_threshold=50,
            )
        return ChainedContentFilter(user_query=filter_query)

    logger.warning(f"Unknown content_filter type: {content_filter}")
    return None


def _build_run_config(
    content_filter: Optional[str],
    filter_query: Optional[str],
    wait_for: Optional[int] = 0,
    session_id: Optional[str] = None,
) -> CrawlerRunConfig:
    """Build CrawlerRunConfig with content filtering and excluded tags."""
    cf = _build_content_filter(content_filter, filter_query)

    # Build markdown generator if we have a content filter
    markdown_generator = None
    if cf is not None:
        markdown_generator = DefaultMarkdownGenerator(content_filter=cf)

    return CrawlerRunConfig(
        word_count_threshold=50,
        excluded_tags=DEFAULT_EXCLUDED_TAGS,
        wait_for=wait_for / 1000 if wait_for else 0,
        markdown_generator=markdown_generator,
        session_id=session_id,
    )



def _build_response(
    url: str,
    result,
    formats: List[str],
) -> Dict[str, Any]:
    """Build standardized response dict from a CrawlResult."""
    md = result.markdown
    raw_md = md.raw_markdown if hasattr(md, 'raw_markdown') else str(md)
    fit_md = md.fit_markdown if hasattr(md, 'fit_markdown') else None

    response_data: Dict[str, Any] = {"success": True, "url": url, "data": {}}

    if "markdown" in formats:
        response_data["data"]["raw_markdown"] = raw_md or ""
        response_data["data"]["fit_markdown"] = fit_md
        response_data["data"]["markdown"] = raw_md or ""  # legacy compat
    if "html" in formats:
        response_data["data"]["html"] = result.cleaned_html
    if "links" in formats:
        response_data["data"]["links"] = result.links
    if "media" in formats:
        response_data["data"]["media"] = result.media

    response_data["data"]["metadata"] = {
        "title": result.metadata.get("title", "") if result.metadata else "",
        "description": result.metadata.get("description", "") if result.metadata else "",
        "language": result.metadata.get("language", "") if result.metadata else "",
        "word_count": len((raw_md or "").split()),
    }
    return response_data


@app.post("/scrape")
async def scrape_url(request: ScrapeRequest):
    http_mode = request.http_mode or "auto"
    content_filter = _build_content_filter(request.content_filter, request.filter_query)
    md_generator = DefaultMarkdownGenerator(content_filter=content_filter) if content_filter else None

    # --- HTTP-first path (no browser, sub-second) ---
    if http_mode in ("auto", "http"):
        try:
            http_strategy = AsyncHTTPCrawlerStrategy()
            config = CrawlerRunConfig(
                word_count_threshold=50,
                excluded_tags=DEFAULT_EXCLUDED_TAGS,
                markdown_generator=md_generator,
            )
            async with AsyncWebCrawler(crawler_strategy=http_strategy) as http_crawler:
                result = await http_crawler.arun(request.url, config=config)
                if result.success:
                    return _build_response(request.url, result, request.formats)
                else:
                    raise HTTPException(
                        status_code=400,
                        detail=f"HTTP fetch failed: {result.error_message}",
                    )
        except HTTPException:
            raise
        except Exception as e:
            raise HTTPException(status_code=400, detail=f"HTTP fetch failed: {str(e)}")

    # --- Browser path (existing behavior, with session rotation) ---
    try:
        if not crawler:
            raise HTTPException(status_code=500, detail="Crawler not initialized")

        session_id = get_session_id()
        config = _build_run_config(
            content_filter=request.content_filter,
            filter_query=request.filter_query,
            wait_for=request.wait_for,
            session_id=session_id,
        )

        result = await crawler.arun(url=request.url, config=config)

        if not result.success:
            raise HTTPException(
                status_code=400,
                detail=f"Scraping failed: {result.error_message}",
            )

        return _build_response(request.url, result, request.formats)

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error scraping {request.url}: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/batch-scrape")
async def batch_scrape_urls(request: BatchScrapeRequest):
    try:
        if not crawler:
            raise HTTPException(status_code=500, detail="Crawler not initialized")

        # Limit concurrency
        semaphore = asyncio.Semaphore(min(request.concurrency, 5))

        async def scrape_single(url: str):
            async with semaphore:
                scrape_req = ScrapeRequest(
                    url=url,
                    formats=request.formats,
                    content_filter=request.content_filter,
                    filter_query=request.filter_query,
                    http_mode=request.http_mode,
                )
                return await scrape_url(scrape_req)

        tasks = [scrape_single(url) for url in request.urls]
        results = await asyncio.gather(*tasks, return_exceptions=True)

        # Process results
        successful_results = []
        for i, result in enumerate(results):
            if isinstance(result, Exception):
                logger.error(f"Error scraping {request.urls[i]}: {str(result)}")
                successful_results.append({
                    "success": False,
                    "url": request.urls[i],
                    "error": str(result)
                })
            else:
                successful_results.append(result)

        return {
            "success": True,
            "total": len(request.urls),
            "results": successful_results
        }

    except Exception as e:
        logger.error(f"Error in batch scraping: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/extract")
async def extract_data(request: ExtractRequest):
    try:
        if not crawler:
            raise HTTPException(status_code=500, detail="Crawler not initialized")

        config = CrawlerRunConfig(word_count_threshold=50)
        result = await crawler.arun(
            url=request.url,
            config=config,
        )

        if not result.success:
            raise HTTPException(status_code=400, detail=f"Extraction failed: {result.error_message}")

        return {
            "success": True,
            "url": request.url,
            "extracted_data": result.extracted_content
        }

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error extracting from {request.url}: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
EOF

EXPOSE 8000

CMD ["python", "/app/crawl4ai_service.py"]